# ─── Required in production ───────────────────────────────────────────────────

# The CMS's own public address. Used in invite and reset links, previews and emails.
CMS_URL=https://cms.your-agency.com

# A random string of at least 32 characters. Signs sessions, preview links and
# hashes. `npm run setup` makes one for local development. Changing it signs
# everyone out and breaks open preview links — nothing else.
CMS_SECRET=

# Postgres. Without it the CMS uses a local PGlite database in data/pglite
# (fine for development and for a single small server with a persistent disk).
# The user needs CREATEROLE once, for the first migration to create the
# restricted `cms_app` role that row-level security runs as.
# DATABASE_URL=postgresql://neondb_owner:npg_1DmiB2OVYEIN@ep-muddy-math-a1dp6dhs-pooler.ap-southeast-1.aws.neon.tech/CMS?sslmode=require&channel_binding=require
# DATABASE_POOL_MAX=10

# Required to reach /setup in production: whoever creates the first agency
# account must know it. Remove it after setup if you like.
CMS_SETUP_TOKEN=

# ─── Email (invites, password resets, sign-in codes, enquiry notifications) ───
# Without SMTP_HOST nothing is sent: invite links are shown on screen instead, and
# in development every email is listed under Agency → Outbox.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=cms@your-agency.com
# MAIL_FROM_NAME=Your Agency

# ─── Images (optional) ────────────────────────────────────────────────────────
# Cloudinary for cover images, inline images and author photos. Each client's
# files live under <CLOUDINARY_FOLDER>/<workspace id>/. Without these, image
# uploads are switched off and posts can still be written.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=cms

# ─── Branding ─────────────────────────────────────────────────────────────────
# Shown on the agency sign-in page and in emails sent for the agency itself.
AGENCY_NAME=Your Agency
# AGENCY_ACCENT=#ff5b2e

# ─── Infrastructure ───────────────────────────────────────────────────────────
# How many reverse proxies sit in front of the CMS (Vercel, a load balancer…).
# Rate limits read the client IP this many hops from the right of X-Forwarded-For.
# TRUSTED_PROXY_COUNT=1

# Let webhooks reach private or plain-http addresses. Development and tests only.
# CMS_ALLOW_PRIVATE_WEBHOOKS=false

# Show Agency → Outbox in production (emails are stored there when SMTP is off).
# CMS_SHOW_OUTBOX=false

# Postgres only: migrate on boot instead of via `npm run db:migrate` / `npm start`.
# CMS_AUTO_MIGRATE=false

# PGlite only: where the local database lives.
# PGLITE_DIR=data/pglite
