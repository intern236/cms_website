# Where the CMS runs, and this site's key (CMS → Settings → Website & keys).
CMS_URL=http://localhost:3000
CMS_SITE_KEY=cms_xxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shown in the same place. Lets the CMS refresh this site the moment content changes.
CMS_WEBHOOK_SECRET=
# This site's public address (used in canonical URLs, sitemap, feed).
SITE_URL=http://localhost:3100
# How many reverse proxies sit in front of this site (for the contact form's rate limit).
TRUSTED_PROXY_COUNT=1
